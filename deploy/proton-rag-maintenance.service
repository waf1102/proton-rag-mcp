[Unit]
Description=Back up and maintain the Proton Mail local index

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/proton-rag/app
EnvironmentFile=%h/.config/proton-rag/mail.env
EnvironmentFile=%h/.config/proton-rag/maintenance.env
ExecStart=%h/.local/share/proton-rag/app/.venv/bin/proton-rag-maintain --engine ${RAG_CONTAINER_ENGINE} --backup-dir %h/.local/share/proton-rag/backups $RAG_MAINTENANCE_OPTIONS
UMask=0077
TimeoutStartSec=30min
MemoryMax=700M
CPUQuota=100%
